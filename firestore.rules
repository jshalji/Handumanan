rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * HANDUMANAN: CULTURAL HERITAGE INFORMATION SYSTEM - SECURITY RULES
     *
     * Core Philosophy:
     * This ruleset enforces a strict user-ownership model for private data (favorites, itineraries) 
     * while allowing public access to cultural knowledge (heritage sites, categories). 
     * Authorization is designed to be independent and performant by leveraging 
     * hierarchical paths and administrative role lookups.
     *
     * Data Structure:
     * - User-specific data is nested under /users/{userId}/ to allow for direct path-based authorization.
     * - Cultural data (Heritage Sites, Categories) are top-level and publicly readable.
     * - Feedback (Reviews) are nested under Heritage Sites to support site-specific listing.
     * - Administrative roles are managed via the existence of documents in the /roles_admin collection.
     * - LGU roles are managed via the 'lgu' role field in /users/{userId}.
     */

    // --- Helper Functions ---

    /** @description Checks if the user is authenticated. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if the authenticated user matches the provided ID. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** @description Checks if the authenticated user is the owner of the existing document. */
    function isExistingOwner(ownerId) {
      return resource != null && 'data' in resource && isOwner(ownerId);
    }

    /** @description Checks if the user has administrative privileges via the user profile role field. */
    function hasAdminProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    /** @description Checks if the user has administrative privileges via the roles_admin collection or profile role. */
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid))
        || hasAdminProfile()
      );
    }

    /** @description Checks if the user has LGU officer privileges via user profile role field. */
    function hasLguProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'lgu';
    }

    /** @description Checks if the write operation only affects allowed LGU verification fields with valid status values. */
    function isLguVerificationOnlyWrite() {
      let allowedFields = ['verificationStatus', 'verifiedBy', 'verifiedByUid', 'verifiedAt', 'verificationNotes', 'entranceFee'];
      let hasValidStatus = request.resource.data.verificationStatus == 'LGU Verified'
        || request.resource.data.verificationStatus == 'Needs Revision'
        || request.resource.data.verificationStatus == 'Rejected'
        || request.resource.data.verificationStatus == 'Pending Verification';
      let isAllowedKeys = resource == null 
        ? request.resource.data.keys().hasOnly(allowedFields)
        : request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedFields);

      return isAllowedKeys && hasValidStatus;
    }

    /** @description Prevents regular users from assigning themselves an admin or LGU role. */
    function hasSafeSelfAssignedRole() {
      return !request.resource.data.keys().hasAny(['role'])
        || request.resource.data.role == 'explorer'
        || request.resource.data.role == 'user';
    }

    /** @description Prevents regular users from changing their own role field. */
    function doesNotChangeRole() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
    }

    // --- Collection Rules ---

    /**
     * @description Root user profiles. Access restricted to the user themselves.
     * @path /users/{userId}
     * @allow (get) If the user is viewing their own profile or is an admin.
     * @deny (list) Prevent public listing of all users.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin() || hasLguProfile();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && hasSafeSelfAssignedRole();
      allow update: if (isExistingOwner(userId) && doesNotChangeRole()) || isAdmin();
      allow delete: if isAdmin();

      /**
       * @description User's favorited heritage sites.
       * @path /users/{userId}/favorites/{favoriteId}
       */
      match /favorites/{favoriteId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == userId;
        allow delete: if isExistingOwner(userId);
      }

      /**
       * @description Personalized AI itineraries for the user.
       * @path /users/{userId}/itineraries/{itineraryId}
       */
      match /itineraries/{itineraryId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == userId;
        allow delete: if isExistingOwner(userId);
      }
    }

    /**
     * @description Heritage site categories (e.g., Churches, Museums).
     * @path /categories/{categoryId}
     */
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Cultural heritage sites in Metro Cebu.
     * @path /heritageSites/{siteId}
     * @allow (get, list) Public access for all visitors.
     * @allow (create, update) Admins (all fields) or LGU officers (sparse verification fields only).
     * @allow (delete) Admins only.
     */
    match /heritageSites/{siteId} {
      allow get, list: if true;
      allow create, update: if isAdmin() || (hasLguProfile() && isLguVerificationOnlyWrite());
      allow delete: if isAdmin();
    }

    /**
     * @description Unified collection group rules for reviews across all heritage sites.
     * @path /{path=**}/reviews/{reviewId}
     */
    match /{path=**}/reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && ((resource != null && resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId) || isAdmin());
      allow delete: if isSignedIn() && ((resource != null && resource.data.userId == request.auth.uid) || isAdmin());
    }

    /**
     * @description Unified collection group rules for visitor photos across all heritage sites.
     * @path /{path=**}/visitorPhotos/{photoId}
     */
    match /{path=**}/visitorPhotos/{photoId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && ((resource != null && resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId) || isAdmin());
      allow delete: if isSignedIn() && ((resource != null && resource.data.userId == request.auth.uid) || isAdmin());
    }

    /**
     * @description Administrative role registry.
     * @path /roles_admin/{adminUid}
     */
    match /roles_admin/{adminUid} {
      allow read, write: if false; 
    }

    /**
     * @description General user feedback submissions queue.
     * @path /userFeedback/{feedbackId}
     */
    match /userFeedback/{feedbackId} {
      allow get, list, update, delete: if isAdmin();
      allow create: if true;
    }
  }
}
