rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * HANDUMANAN: CULTURAL HERITAGE INFORMATION SYSTEM - SECURITY RULES
     *
     * Core Philosophy:
     * This ruleset enforces a strict user-ownership model for private data (favorites, itineraries) 
     * while allowing public access to cultural knowledge (heritage sites, categories). 
     * Authorization is designed to be independent and performant by leveraging 
     * hierarchical paths and administrative role lookups.
     *
     * Data Structure:
     * - User-specific data is nested under /users/{userId}/ to allow for direct path-based authorization.
     * - Cultural data (Heritage Sites, Categories) are top-level and publicly readable.
     * - Feedback (Reviews) are nested under Heritage Sites to support site-specific listing.
     * - Administrative roles are managed via the existence of documents in the /roles_admin collection.
     *
     * Key Security Decisions:
     * 1. Authorization Independence: We use UIDs in the path (e.g., /users/{userId}) to verify 
     *    ownership without extra database reads.
     * 2. Denormalization for Security: Ownership fields (userId) are required on documents 
     *    like Reviews to ensure that even if the document path is shared, only the 
     *    original author can modify the content.
     * 3. Prototyping Flexibility: These rules focus on "Who can access what" (Authorization) 
     *    rather than "What does the data look like" (Schema validation), facilitating 
     *    rapid iteration of the Handumanan features.
     * 4. Admin Role: Administrative privileges for managing heritage sites are determined 
     *    by the presence of a user's UID in the 'roles_admin' collection.
     */

    // --- Helper Functions ---

    /** @description Checks if the user is authenticated. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if the authenticated user matches the provided ID. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** @description Checks if the authenticated user is the owner of the existing document. */
    function isExistingOwner(ownerId) {
      return resource != null && isOwner(ownerId);
    }

    /** @description Checks if the user has administrative privileges via the roles_admin collection. */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // --- Collection Rules ---

    /**
     * @description Root user profiles. Access restricted to the user themselves.
     * @path /users/{userId}
     * @allow (get) If the user is viewing their own profile.
     * @deny (list) Prevent public listing of all users.
     * @principle Restricts access to a user's own data tree.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // User listing is disallowed for privacy
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if false; // Profile deletion handled by admin or specific logic

      /**
       * @description User's favorited heritage sites.
       * @path /users/{userId}/favorites/{favoriteId}
       * @allow (create) User adding a site to their favorites.
       * @deny (write) Users modifying favorites belonging to someone else.
       * @principle Path-based authorization for user-owned subcollections.
       */
      match /favorites/{favoriteId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == userId;
        allow delete: if isExistingOwner(userId);
      }

      /**
       * @description Personalized AI itineraries for the user.
       * @path /users/{userId}/itineraries/{itineraryId}
       * @allow (list) User viewing their trip history.
       * @deny (get) Unauthenticated access to private itineraries.
       * @principle Enforces strict ownership of personalized generated content.
       */
      match /itineraries/{itineraryId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == userId;
        allow delete: if isExistingOwner(userId);
      }
    }

    /**
     * @description Heritage site categories (e.g., Churches, Museums).
     * @path /categories/{categoryId}
     * @allow (get, list) Public access for discovery.
     * @deny (write) Non-admin users attempting to modify categories.
     * @principle Publicly readable with admin-only write access.
     */
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Cultural heritage sites in Metro Cebu.
     * @path /heritageSites/{siteId}
     * @allow (get, list) Public access for all visitors.
     * @deny (delete) Deletion by non-admin users.
     * @principle Publicly readable with admin-only write access.
     */
    match /heritageSites/{siteId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();

      /**
       * @description User reviews for specific heritage sites.
       * @path /heritageSites/{siteId}/reviews/{reviewId}
       * @allow (create) Authenticated user submitting feedback.
       * @deny (update) User trying to edit someone else's review.
       * @principle Public feedback with owner-validated writes via denormalized userId.
       */
      match /reviews/{reviewId} {
        allow get, list: if true;
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update: if isExistingOwner(resource.data.userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(resource.data.userId);
      }
    }

    /**
     * @description Administrative role registry.
     * @path /roles_admin/{adminUid}
     * @allow (none) Directly managed via Cloud Functions or Admin SDK for security.
     * @principle Administrative access control must be immutable from the client.
     */
    match /roles_admin/{adminUid} {
      allow read, write: if false; 
    }
  }
}