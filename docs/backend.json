
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user account within the Handumanan system, storing authentication details and basic profile information. Includes role-based access control.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the User entity."
        },
        "name": {
          "type": "string",
          "description": "The full name of the user."
        },
        "email": {
          "type": "string",
          "description": "The email address of the user, used for login and communication.",
          "format": "email"
        },
        "role": {
          "type": "string",
          "description": "The role of the user (e.g., 'user', 'admin').",
          "enum": ["user", "admin"]
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the user account was created.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "email",
        "role",
        "createdAt"
      ]
    },
    "Category": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Category",
      "type": "object",
      "description": "Represents a categorization for cultural heritage sites.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Category entity."
        },
        "name": {
          "type": "string",
          "description": "The name of the category (e.g., 'Churches', 'Museums')."
        },
        "description": {
          "type": "string",
          "description": "A brief description of the category."
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "HeritageSite": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "HeritageSite",
      "type": "object",
      "description": "Represents a cultural heritage site in Metro Cebu.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the HeritageSite entity."
        },
        "name": {
          "type": "string",
          "description": "The official name of the heritage site."
        },
        "description": {
          "type": "string",
          "description": "Short description."
        },
        "significance": {
          "type": "string",
          "description": "Historical significance."
        },
        "category": {
          "type": "string",
          "description": "The category name."
        },
        "city": {
          "type": "string",
          "description": "The city location."
        },
        "location": {
          "type": "string",
          "description": "The address."
        },
        "visitingHours": {
          "type": "string",
          "description": "Hours of operation."
        },
        "imageUrl": {
          "type": "string",
          "description": "Main image URL."
        },
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        },
        "rating": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "name",
        "category",
        "city",
        "latitude",
        "longitude"
      ]
    },
    "Review": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Review",
      "type": "object",
      "description": "User-submitted feedback.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "siteId": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "userId", "siteId", "rating", "comment", "createdAt"
      ]
    },
    "Favorite": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Favorite",
      "type": "object",
      "description": "User's saved heritage sites.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "siteId": { "type": "string" },
        "siteName": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "userId", "siteId", "createdAt"
      ]
    },
    "Itinerary": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Itinerary",
      "type": "object",
      "description": "Saved AI itineraries.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "itineraryData": { "type": "string" },
        "summary": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "userId", "itineraryData", "createdAt"
      ]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/backend/entities/User"
          },
          "description": "Root collection for user profiles."
        }
      },
      {
        "path": "/users/{userId}/favorites/{favoriteId}",
        "definition": {
          "entityName": "Favorite",
          "schema": {
            "$ref": "#/backend/entities/Favorite"
          },
          "description": "User's favorites."
        }
      },
      {
        "path": "/users/{userId}/itineraries/{itineraryId}",
        "definition": {
          "entityName": "Itinerary",
          "schema": {
            "$ref": "#/backend/entities/Itinerary"
          },
          "description": "User's itineraries."
        }
      },
      {
        "path": "/categories/{categoryId}",
        "definition": {
          "entityName": "Category",
          "schema": {
            "$ref": "#/backend/entities/Category"
          },
          "description": "Heritage site categories."
        }
      },
      {
        "path": "/heritageSites/{siteId}",
        "definition": {
          "entityName": "HeritageSite",
          "schema": {
            "$ref": "#/backend/entities/HeritageSite"
          },
          "description": "Top-level collection for all cultural heritage sites."
        }
      },
      {
        "path": "/heritageSites/{siteId}/reviews/{reviewId}",
        "definition": {
          "entityName": "Review",
          "schema": {
            "$ref": "#/backend/entities/Review"
          },
          "description": "Subcollection for user reviews."
        }
      },
      {
        "path": "/roles_admin/{adminUid}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/backend/entities/User"
          },
          "description": "Database access control for administrators."
        }
      }
    ]
  }
}
